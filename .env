# ══════════════════════════════════════════
# ⚙️  CONFIGURATION GÉNÉRALE
# ══════════════════════════════════════════
BOT_NAME=Elya Prime
PREFIX=!
MAX_HISTORY=20
# Plusieurs numéros admin possibles, séparés par des virgules (format: <numero>@s.whatsapp.net)
OWNER_NUMBERS=22871406871,22893926249,22896651556,22879757503,22897526415

# ══════════════════════════════════════════
# 📱 CONNEXION WHATSAPP
# ══════════════════════════════════════════
# QR (par défaut) ou code de jumelage par numéro (moins fiable actuellement, bug connu de Baileys)
USE_PAIRING_CODE=true
PAIRING_NUMBER=22896651556

# Notification Telegram du QR/pairing code (optionnel) — laisse vide pour désactiver
TELEGRAM_BOT_TOKEN=8608361439:AAEwJthQGMyQAmxfyp8DpeMzGglmn87F5tc
TELEGRAM_CHAT_ID=8080169344

# ══════════════════════════════════════════
# 📊 DASHBOARD WEB
# ══════════════════════════════════════════
DASHBOARD_PORT=3000
# OBLIGATOIRE : le serveur refuse de démarrer sans cette variable (protège l'accès au dashboard)
DASHBOARD_PASSWORD=choisis_un_mot_de_passe_fort_ici

# ══════════════════════════════════════════
# 🗄️  BASE DE DONNÉES (optionnel — JSON par défaut si rien n'est défini)
# ══════════════════════════════════════════
# Une seule suffit. Priorité : Mongo > Postgres > MySQL si plusieurs sont définies.
MONGO_URL=
POSTGRES_URL=
MYSQL_URL=

# ══════════════════════════════════════════
# 💾 STOCKAGE FICHIER (utile surtout pour Railway/volume persistant)
# ══════════════════════════════════════════
# DATA_DIR=/data/data
# AUTH_DIR=/data/auth_info

# ══════════════════════════════════════════
# 🧠 MODÈLE IA PAR DÉFAUT — Google Gemini
# ══════════════════════════════════════════
GEMINI_API_KEY=ta_cle_gemini_ici
GEMINI_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

