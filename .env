# ══════════════════════════════════════════
# 🛠️  OUTILS & SERVICES TIERS
# ══════════════════════════════════════════

# --- Génération d'images (Pollinations, repli si Gemini/NanoBanana échoue) ---
POLLINATIONS_API_KEY=ta_cle_pollinations_ici

# --- Service vocal local (voix<->texte), voir voice/service.py ---
# Démarré automatiquement avec le bot (rien à faire si python3 + pip install sont OK).
# AUTO_START_VOICE_SERVICE=false  # désactive le démarrage automatique
# VOICE_PORT=5001
# WHISPER_MODEL_SIZE=small        # tiny|base|small|medium|large (plus gros = plus précis mais plus lent/lourd)
# WHISPER_DEVICE=cpu              # ou "cuda" si un GPU est disponible
# ELYA_VOICE_NAME=fr-FR-DeniseNeural  # voix edge-tts (ex: fr-FR-HenriNeural, fr-FR-EloiseNeural)
# PYTHON_BIN=python3              # au besoin, chemin vers l'exécutable Python

# --- Transcription vocale : repli si le service vocal local ne répond pas (facultatif) ---
ASSEMBLYAI_API_KEY=ta_cle_assemblyai_ici

# --- Détection de liens : groupe WhatsApp cible (format: 123456789@g.us) ---
TARGET_LINKS_GROUP=

# --- Google Drive (!drive) — clé JSON d'un compte de service, encodée en base64 ---
GOOGLE_SERVICE_ACCOUNT_BASE64=
GOOGLE_DRIVE_FOLDER_ID=

# --- Actualités ---
NEWSDATA_API_KEY=

# --- Maxxtech (deepseek, code, recherche web) ---
MAXXTECH_API_KEY=

# --- Tavily (recherche web fiable pour !recherche) ---
TAVILY_API_KEY=

# --- davidcyriltech (recherche Google, téléchargeurs, outils PDF/web, Kimi, Nova...) ---
# Renvoyait 401 (non autorisé) lors de nos tests même sans paramètre : semble
# exiger une clé. Sans elle, les commandes concernées (.gsearch, .apk, .gdrive,
# .webdl, .compresspdf, .pdf2jpg, .ssweb, .web2zip, .web2apk, .shorturl,
# .tgsticker, .ghstalk, .kimi, .nova, !diffusion, !writecream, !ttsg) échouent
# proprement avec un message clair plutôt que de planter.
DAVIDCYRIL_API_KEY=dc_live_noVrxovlz2FoMPEgio7MC7KYSbAs3Lpj
